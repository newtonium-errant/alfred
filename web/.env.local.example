# Algernon web frontend — local env. Copy to `.env.local` (gitignored).
#
# FE-1 (design system / shell): only the instance display name is read.
# The `NEXT_PUBLIC_` prefix inlines it into the browser bundle at build —
# it is NOT a secret (just the header/title label). Defaults to "Algernon".
NEXT_PUBLIC_INSTANCE_NAME=Salem

# --- FE-2 (BFF → transport) — server-side ONLY, never NEXT_PUBLIC_ ----------
# Required for the chat to function. The BFF reads these at request time.
# The transport base URL the BFF reaches (the talker daemon's aiohttp app).
# Default transport bind is 127.0.0.1:8891 (transport.server host/port).
# ALFRED_WEB_TRANSPORT_URL=http://127.0.0.1:8891
# The peer token (config `auth.tokens.web.token`). Held server-side in the BFF;
# the browser never sees it.
# ALFRED_WEB_PEER_TOKEN=
# The peer/client name the transport knows this front-end by — must match the
# backend's web peer entry in `auth.tokens`. Defaults to "web" if unset.
# ALFRED_WEB_PEER_CLIENT=web

# --- Local-dev session token (server-side ONLY) ----------------------------
# B3 live contract: /chat/* identity is the instance-signed session token,
# relayed as `X-Alfred-Session`. In normal use the token is minted by login
# (FE-3: /auth/verify) and stored in an httpOnly cookie. For local dev BEFORE
# the login UI — or to test /chat against the real backend without the Resend
# email round-trip — paste a token from the backend's dev handshake here and the
# BFF will use it as a fallback when no session cookie is present.
# ALFRED_WEB_DEV_SESSION_TOKEN=

# --- Bulk scan upload (#83) — server-side ONLY --------------------------------
# The /batch surface relays a multipart submission to the box's POST /vault/batch.
# It needs its OWN token (config `auth.tokens.web_batch.token`), NOT the chat one:
# the box PEER-PINS `web_batch` on that route precisely because the chat `web`
# token and this one can both carry `allowed_clients: [web]`, so reusing the chat
# token here is refused by the pin — and reusing THIS one for chat would be a
# privilege escalation. One token, one door. Generate with token_hex(32).
# Absent ⇒ the BFF fail-closes with `transport_misconfigured` (never a silent
# half-configured relay). Reuses ALFRED_WEB_TRANSPORT_URL above.
# ALFRED_WEB_BATCH_TOKEN=
# The client name the transport knows this door by — defaults to "web".
# ALFRED_WEB_BATCH_PEER_CLIENT=web
#
# PER-INSTANCE batch targets (#90) — same family shape as ALFRED_WEB_CHAT_*.
# Each target needs BOTH keys or it is ignored (fail-closed: a half-configured
# instance never appears in the picker, so it cannot be chosen and then fail at
# submit after thirty pages were scanned). _LABEL is optional display text.
#   ALFRED_WEB_BATCH_<NAME>_URL    — that instance's transport base URL
#   ALFRED_WEB_BATCH_<NAME>_TOKEN  — that instance's own `web_batch` token
#   ALFRED_WEB_BATCH_<NAME>_LABEL  — optional; defaults to <NAME>
# The HOME instance is NOT listed here — it uses the unprefixed pair above and
# is the picker's default. A prefixed pair naming home is ignored rather than
# shadowing it, so "which env did this use?" always has one answer.
# ALFRED_WEB_BATCH_VERA_URL=http://127.0.0.1:8893
# ALFRED_WEB_BATCH_VERA_TOKEN=
# ALFRED_WEB_BATCH_VERA_LABEL=VERA

# --- Web STT (voice) — no new env --------------------------------------------
# STT rides the SAME transport env as chat (ALFRED_WEB_TRANSPORT_URL /
# ALFRED_WEB_PEER_TOKEN / ALFRED_WEB_PEER_CLIENT) — the BFF relays the audio to
# the talker daemon's /stt/transcribe on the existing transport. No extra FE env.

# --- Web voice V0 (WebRTC echo transport) — DISPLAY gate only -----------------
# Whether to SHOW the voice affordance in the chat surface. Default off (absent ⇒
# the panel renders nothing). This is a DISPLAY flag only — the authoritative gate
# is the backend `web.voice.enabled` (GET /voice/config → available:false ⇒ no
# affordance even if this is on). Set to 1 to reveal it in local dev.
# NEXT_PUBLIC_VOICE_ENABLED=1
#
# The voice signalling routes (/api/voice/config|offer|close) ride the SAME
# transport env as chat/STT (ALFRED_WEB_TRANSPORT_URL / _PEER_TOKEN / _PEER_CLIENT)
# — NO new server env. Media flows DIRECT browser↔server UDP (never through the
# BFF); signalling is the only thing the BFF relays.

# --- Unified chat composer (#97) — DISPLAY gate only -------------------------
# Whether the chat page's composer is the UNIFIED one: a single Attach that
# takes images, .md/.txt/.csv/.pdf and audio, and routes each attachment set by
# a visible one-tap chip — Discuss (into the conversation), Batch (bulk scans on
# the drip schedule), or File to vault (deterministic-create ingest).
#
# DEFAULT OFF, and deliberately so: the chip defaults decide where a document
# ends up, so they get an operator walkthrough before anything routes by them.
# Absent ⇒ /chat renders exactly the composer that has been live all along.
#
# A DISPLAY flag only. Every route behind it keeps its own server-side gate — an
# instance with no ALFRED_WEB_INGEST_<NAME>_* pair still refuses a filing, by
# name, flag or no flag — so turning this on cannot reach a pipeline that was
# not already reachable from its own page. The standalone /ingest and /batch
# pages stay where they are either way.
#
# On: 1, true, on, yes (case-insensitive). Anything else is off.
# NEXT_PUBLIC_UNIFIED_COMPOSER=1

# --- In-app bug reporter (#95) — server-side ONLY -----------------------------
# The floating 🐛 button relays a report to the box's POST /vault/bugreport.
# It needs its OWN token (config `auth.tokens.web_bugreport.token`), NOT the
# chat / ingest / batch one: the box PEER-PINS `web_bugreport` on that route for
# the same reason every sibling route pins its own — all four tokens can
# legitimately carry `allowed_clients: [web]`, so `allowed_clients` cannot tell
# them apart. One token, one door. Generate with token_hex(32).
# Absent ⇒ the BFF fail-closes with 503 `bugreport_not_configured` and the
# dialog says bug reporting isn't switched on here — so leaving this unset is a
# deploy that ships the button DARK rather than one that loses reports.
# Reuses ALFRED_WEB_TRANSPORT_URL above; SINGLE-HOME (no per-instance family —
# reports land on the home instance whichever surface they were filed from).
# ALFRED_WEB_BUGREPORT_TOKEN=
# The client name the transport knows this door by — defaults to "web".
# ALFRED_WEB_BUGREPORT_PEER_CLIENT=web

# --- Cross-instance CHAT (instance switcher) — server-side ONLY --------------
# Lets the owner chat with OTHER instances (KAL-LE / Hypatia / VERA) from the web
# via the instance switcher. The HOME instance (NEXT_PUBLIC_INSTANCE_NAME, e.g.
# Salem) is ALWAYS available and rides the existing session path — do NOT add a
# CHAT env pair for it. One env PAIR per CROSS-INSTANCE target; a target appears
# in the switcher ONLY when BOTH its _URL and _TOKEN are set (fail-closed). The
# BFF is the SOLE holder of these tokens — the browser only ever sees
# {name, label} via /api/chat/targets.
#
#   ALFRED_WEB_CHAT_<NAME>_URL    transport base URL of the target (loopback)
#   ALFRED_WEB_CHAT_<NAME>_TOKEN  that target's DEDICATED `web` peer token — the
#                                 full-talker-scope chat token. MUST be DISTINCT
#                                 from that instance's `web_ingest` token and from
#                                 every other instance's token (decision M4).
#   ALFRED_WEB_CHAT_<NAME>_LABEL  (optional) display label; defaults to <NAME>
#
# <NAME> is the switcher's instance value (letters/digits/underscore). Ports:
# KAL-LE 8892, Hypatia 8893, VERA 8894 (all 127.0.0.1, loopback-only).
# ALFRED_WEB_CHAT_KALLE_URL=http://127.0.0.1:8892
# ALFRED_WEB_CHAT_KALLE_TOKEN=
# ALFRED_WEB_CHAT_KALLE_LABEL=KAL-LE
# ALFRED_WEB_CHAT_HYPATIA_URL=http://127.0.0.1:8893
# ALFRED_WEB_CHAT_HYPATIA_TOKEN=
# ALFRED_WEB_CHAT_HYPATIA_LABEL=Hypatia
# ALFRED_WEB_CHAT_VERA_URL=http://127.0.0.1:8894
# ALFRED_WEB_CHAT_VERA_TOKEN=
# ALFRED_WEB_CHAT_VERA_LABEL=VERA

# --- Bearer capture door (/api/ingest/shortcut) — server-side ONLY ------------
# The token-authed capture route: iOS Shortcuts today, Android Tasker / a
# Quick-Settings tile / any client that can send a bearer POST. It is the SIBLING
# of the session-authed ingest above, NOT a replacement — it exists for clients
# with no cookie jar, and mints no session. Recipes: docs/android_capture_recipes.md
#
# DEPLOY-INERT UNTIL THE TOKEN IS SET: with SHORTCUT_INGEST_TOKEN unset or blank
# the route answers 503 not_configured for every request. There is no cookie
# fallback, ever. Everything else here is optional and has a working default.
#
# A long random secret the device sends as `Authorization: Bearer <token>`.
# Held by the device AND this server; surrounding whitespace is tolerated.
# SHORTCUT_INGEST_TOKEN=
#
# Who captures are attributed to — rides the record's `ingested_by` and the
# X-Alfred-Ingest-User header. Defaults to "Andrew (shortcut)".
# SHORTCUT_INGEST_USER=Andrew (shortcut)
#
# Provenance stamped into the record's `source:`. Defaults to "iOS Shortcut" —
# SET THIS on any non-iOS device or every capture claims a false origin.
# SHORTCUT_INGEST_SOURCE_LABEL=Android (Tasker)
#
# Instance a capture goes to when the request names none. Matched
# case-insensitively against the configured ingest targets. Defaults to "salem".
# SHORTCUT_INGEST_DEFAULT_TARGET=salem
#
# Abuse ceiling: captures per hour per token. Non-numeric or non-positive values
# degrade to the default 30.
# SHORTCUT_INGEST_RATE_MAX=30
#
# Spoken aliases for voice-directive routing ("message for Hypatia, …"), as a
# JSON object of canonical instance name → alias list. For speech-to-text
# mangling. Malformed JSON falls back to the built-in defaults.
# SHORTCUT_DIRECTIVE_ALIASES={"hypatia":["high patia","hypatiya"]}

# --- Cross-instance ingest — server-side ONLY, never NEXT_PUBLIC_ -------------
# One env PAIR per ingest target instance the operator may write to. A target
# appears in the picker ONLY when BOTH its _URL and _TOKEN are set (fail-closed);
# a half-configured target is skipped. The BFF is the SOLE holder of these tokens
# — the browser only ever sees {name, label, recordTypes} via /api/ingest/targets.
#
#   ALFRED_WEB_INGEST_<NAME>_URL    transport base URL of the target (loopback)
#   ALFRED_WEB_INGEST_<NAME>_TOKEN  that target's DEDICATED `web_ingest` peer token
#                                   (distinct per target — never reuse the chat
#                                   `web` token or another target's token)
#   ALFRED_WEB_INGEST_<NAME>_LABEL  (optional) display label; defaults to <NAME>
#
# <NAME> is the picker's `target` value (letters/digits/underscore). Ports:
# Salem 8891, KAL-LE 8892, Hypatia 8893, VERA 8894 (all 127.0.0.1, loopback-only).
# ALFRED_WEB_INGEST_SALEM_URL=http://127.0.0.1:8891
# ALFRED_WEB_INGEST_SALEM_TOKEN=
# ALFRED_WEB_INGEST_SALEM_LABEL=Salem
# ALFRED_WEB_INGEST_KALLE_URL=http://127.0.0.1:8892
# ALFRED_WEB_INGEST_KALLE_TOKEN=
# ALFRED_WEB_INGEST_KALLE_LABEL=KAL-LE
# ALFRED_WEB_INGEST_HYPATIA_URL=http://127.0.0.1:8893
# ALFRED_WEB_INGEST_HYPATIA_TOKEN=
# ALFRED_WEB_INGEST_HYPATIA_LABEL=Hypatia
# ALFRED_WEB_INGEST_VERA_URL=http://127.0.0.1:8894
# ALFRED_WEB_INGEST_VERA_TOKEN=
# ALFRED_WEB_INGEST_VERA_LABEL=VERA
