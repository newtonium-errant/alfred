# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Runtime data
data/
!data/.gitkeep

# Batch scan intake (#83). Normally these live under the instance's data dir
# (data/batch/<instance>/<id>/) and are covered by the rule above — but a
# batch route reachable with an unset data_dir resolves the path against the
# process CWD, which puts a REPO-ROOT batch/ tree one misconfiguration away.
# That is not hypothetical: it is how two smoke artifacts were committed in
# 251b2a5a. Ignored here so the accident cannot recur, and because the debris
# guard structurally cannot catch it — a TRACKED file is "present at session
# start" by definition, so the guard reports the tree clean.
#
# THE LEADING SLASH IS LOAD-BEARING. A bare `batch/` matches a directory of
# that name at ANY DEPTH, so it also swallowed `web/pages/api/batch/` and
# shadowed `src/alfred/batch/` — two real source packages that happen to share
# the word. That is not a hypothetical either: the unanchored form silently
# excluded `web/pages/api/batch/targets.ts` from #90's commit. `git add`
# NO-OPS on an ignored path and `git status` still reports clean, so the
# worktree was correct, every suite run was correct, and the COMMITTED tree
# was broken — a failure the worktree structurally cannot show you.
#
# Root-anchored, it means "the batch/ directory at the repo root" and nothing
# else, which is all this rule ever needed to say. `tests/test_gitignore_scope.py`
# holds the line for both packages.
/batch/

# Config with secrets
.env
config.yaml
# Per-instance configs (config.kalle.yaml, config.stayc.yaml, etc.) —
# each holds its own secrets/tokens and should not be checked in.
config.*.yaml
!config.*.yaml.example
# Manual config backups taken before risky changes (e.g.
# config.yaml.bak.before_classifier). Same hygiene as config.yaml.
config.yaml.bak.*

# IDE
.vscode/
.idea/

# Claude Code local state (per-project session cache, not shared)
.claude/projects/
# Runtime lockfile written by the /schedule skill.
.claude/scheduled_tasks.lock
# Agent isolation worktrees created by the Agent tool's isolation: "worktree".
.claude/worktrees/

# Ink TUI
tui-ink/node_modules/
tui-ink/dist/

# Private repos (separate standalone repos, not part of this monorepo)
alfred-ctrl/
alfred-saas/
alfred-docs/
alfred-documentation/

# Finished n8n workflows (local only, repo is for coding knowledge)
workflows/

# Vault is a self-contained nested git repo (vault/.git) with its own daily
# snapshot system — the outer repo tracks NONE of it. Untracked 2026-06-25:
# session/ + process/ were formerly tracked here, which made a git-on-box
# `reset --hard` able to clobber the live vault. Now fully box-local and
# owned by the nested repo (also keeps talker conversation records off GitHub).
/vault/

# Pytest / coverage artifacts
htmlcov/
.coverage
.coverage.*
coverage.xml

# OS
.DS_Store
Thumbs.db
.msgbus/
